{
  "name": "@maciejtrzcinski/sanity-plugin-section-builder",
  "version": "1.0.2",
  "description": "Visual page-builder section picker for Sanity Studio — thumbnail previews in the array editor, edit pane, and insert menu, driven by a single section registry.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "page-builder",
    "preview",
    "section",
    "insert-menu"
  ],
  "homepage": "https://github.com/maciejtrzcinski/sanity-plugin-section-builder#readme",
  "bugs": {
    "url": "https://github.com/maciejtrzcinski/sanity-plugin-section-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciejtrzcinski/sanity-plugin-section-builder.git"
  },
  "license": "MIT",
  "author": "Maciej Trzciński",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pkg-utils build --clean",
    "check": "npm run lint && npm run type-check && npm run format:check && npm run knip && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "watch": "pkg-utils watch"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "not ios_saf < 13",
    "not safari < 13",
    "not dead",
    "maintained node versions"
  ],
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/prettier-config": "^3.0.0",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.22.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^5.0.0 || ^6.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
